<?xml version="1.0" encoding="utf-8"?>
<!--
    Une partie d'une heure, dans l'esprit de Coptic Reader : ligne de titre compacte et cliquable
    (replie/déplie, chevron en fin de ligne), corps marqué par un filet vertical discret.
    En mode bilingue le corps est sur deux colonnes : français (LTR) à gauche, arabe (RTL) à droite.
    Le sens (LTR/RTL) est fixé par l'adaptateur selon la langue réelle du texte.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sectionRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">

    <!-- En-tête : Titre [marque-page] [chevron] [⋮] ; toute la ligne replie/déplie. -->
    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="46dp"
        android:orientation="horizontal">

        <!-- Titres centrés : espace symétrique du chevron + ⋮ pour un centrage absolu dans la ligne. -->
        <Space
            android:id="@+id/spaceTitleStart"
            android:layout_width="72dp"
            android:layout_height="0dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textViewSectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.LivreAGPIA.ReadingTitle"
            tools:text="Psaume 50" />

        <ImageView
            android:id="@+id/imageBookmarked"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/bookmark"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_bookmark"
            app:tint="?attr/colorPrimary"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/imageChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_expand_more"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/buttonMore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more_actions"
            app:srcCompat="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <!-- Corps (masqué quand la partie est repliée) : filet + texte, ou deux colonnes en bilingue. -->
    <LinearLayout
        android:id="@+id/bodyRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="18dp">

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:id="@+id/textViewSectionContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.3"
            android:paddingStart="14dp"
            android:paddingEnd="0dp"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.LivreAGPIA.Reading"
            android:textIsSelectable="true"
            tools:text="Pitié pour moi, mon Dieu, en Ton amour,\nselon Ta grande miséricorde, efface mon péché…" />

        <!-- Colonne arabe (mode bilingue uniquement), séparée par un filet. -->
        <View
            android:id="@+id/columnDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/colorOutlineVariant"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textViewSectionContentArabic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.3"
            android:textAlignment="textStart"
            android:textAppearance="@style/TextAppearance.LivreAGPIA.Reading"
            android:textDirection="rtl"
            android:textIsSelectable="true"
            android:visibility="gone"
            tools:text="ارحمني يا الله كعظيم رحمتك، ومثل كثرة رأفتك تمحو إثمي."
            tools:visibility="visible" />

    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:dividerColor="?attr/colorOutlineVariant" />

</LinearLayout>
