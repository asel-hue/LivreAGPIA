<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.AboutActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/textViewAppVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Version de l'application : 1.3.0 (4)" />

                <TextView
                    android:id="@+id/textViewContentVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Version du contenu : 1 (2026-10-26)" />
            </LinearLayout>

            <TextView
                style="@style/Widget.LivreAGPIA.SettingsHeader"
                android:text="@string/about_sources_title" />

            <TextView
                android:id="@+id/textViewSources"
                style="@style/Widget.LivreAGPIA.AboutBody"
                tools:text="@string/about_sources_text" />

            <TextView
                style="@style/Widget.LivreAGPIA.SettingsHeader"
                android:text="@string/about_font_title" />

            <TextView
                android:id="@+id/textViewFont"
                style="@style/Widget.LivreAGPIA.AboutBody"
                tools:text="@string/about_font_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLicense"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/about_view_license" />

            <TextView
                style="@style/Widget.LivreAGPIA.SettingsHeader"
                android:text="@string/about_rights_title" />

            <TextView
                android:id="@+id/textViewRights"
                style="@style/Widget.LivreAGPIA.AboutBody"
                tools:text="@string/about_rights_text" />

            <TextView
                style="@style/Widget.LivreAGPIA.SettingsHeader"
                android:text="@string/about_privacy_title" />

            <TextView
                style="@style/Widget.LivreAGPIA.AboutBody"
                android:text="@string/about_privacy_text" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
