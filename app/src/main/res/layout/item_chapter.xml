<?xml version="1.0" encoding="utf-8"?>
<!--
    Une heure dans la liste d'accueil : vignette (hour_N.webp si présente, sinon numéro dans un rond)
    et titre, dans l'esprit des tuiles illustrées de Coptic Reader.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <!-- Vignette au format portrait : l'icône est montrée entière (pas de recadrage des visages). -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="72dp">

        <TextView
            android:id="@+id/textViewChapterNumber"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_chapter_number"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnPrimaryContainer"
            tools:text="1" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHourImage"
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="56dp"
            android:layout_height="72dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="12dp"
            app:contentPadding="3dp"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/imageHour"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/hour_image"
                android:scaleType="fitCenter" />

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <TextView
        android:id="@+id/textViewChapterTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.LivreAGPIA.ListTitle"
        tools:text="Prière de l'aube" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_chevron_right"
        app:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
