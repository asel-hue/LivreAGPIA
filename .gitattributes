# Normalisation des fins de ligne
* text=auto

# Scripts : le wrapper Gradle doit rester en LF (exécuté sous Linux/macOS/CI)
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Fichiers binaires
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ttf binary
*.otf binary
*.jar binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
